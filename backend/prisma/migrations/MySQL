WITH RECURSIVE numeros AS (
    SELECT 501 AS n
    UNION ALL
    SELECT n + 1
    FROM numeros
    WHERE n < 1000
)
SELECT
    n,
    UUID() AS user_id,
    CONCAT('Usuario Teste ', LPAD(n, 4, '0')) AS nome,
    CONCAT('usuario.teste.', n, '@exemplo.com') AS email
FROM numeros;

