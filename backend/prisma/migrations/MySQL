    'NAO_UTILIZAR_PARA_LOGIN',
    nome,
    CONCAT('119', LPAD(n, 8, '0')),
    'CUSTOMER',
    NOW(3),
    NOW(3)
FROM novos_usuarios;

INSERT INTO addresses (
    id, userId, label, recipient, street, number,
    complement, district, city, state, zipCode,
    isDefault, createdAt, updatedAt
)
SELECT
    UUID(),
    user_id,
    'Endereco principal',
    nome,
    CONCAT('Rua de Teste ', n),
    CAST(n AS CHAR),
    NULL,
    CONCAT('Bairro ', LPAD(MOD(n, 50) + 1, 2, '0')),
    CONCAT('Cidade ', LPAD(MOD(n, 20) + 1, 2, '0')),
    CASE MOD(n, 5)
        WHEN 0 THEN 'SP'
        WHEN 1 THEN 'RJ'
