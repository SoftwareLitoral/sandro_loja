-- =========================================================
-- CADASTRAR USUARIOS
-- =========================================================


USE loja_do_sandro;

-- =====================================================
-- CADASTRAR 500 USUARIOS FICTICIOS COM ENDERECOS
-- Requer MySQL 8.0+
-- =====================================================

START TRANSACTION;

-- Gera uma lista temporaria com IDs e dados consistentes
-- para relacionar cada usuario ao seu endereco.

CREATE TEMPORARY TABLE seed_usuarios AS
WITH RECURSIVE numeros AS (
    SELECT 1 AS n
    UNION ALL
    SELECT n + 1
    FROM numeros
    WHERE n < 500
)
SELECT
    n,
    UUID() AS user_id,
    CONCAT('Usuario Teste ', LPAD(n, 3, '0')) AS nome,
    CONCAT('usuario.teste.', n, '@exemplo.com') AS email,
    CONCAT('Rua de Teste ', n) AS rua,
    CONCAT('Bairro ', LPAD(((n - 1) MOD 50) + 1, 2, '0')) AS bairro,
    CONCAT('Cidade ', LPAD(((n - 1) MOD 20) + 1, 2, '0')) AS cidade,
    CASE MOD(n, 5)
        WHEN 0 THEN 'SP'
        WHEN 1 THEN 'RJ'
        WHEN 2 THEN 'MG'
        WHEN 3 THEN 'PR'
        ELSE 'SC'
    END AS estado,
    CONCAT(LPAD(MOD(n, 100000000), 8, '0')) AS cep
FROM numeros;

-- Insere os 500 usuarios.
-- A senha abaixo e apenas um marcador de teste,
-- NAO e um hash valido para login com bcrypt.

INSERT INTO users (
    id,
    email,
    passwordHash,
    name,
    phone,
    role,
    createdAt,
    updatedAt
)
SELECT
    user_id,
    email,
    'NAO_UTILIZAR_PARA_LOGIN',
    nome,
    CONCAT('119', LPAD(n, 8, '0')),
    'CUSTOMER',
    NOW(3),
    NOW(3)
FROM seed_usuarios;

-- Insere um endereco para cada usuario.

INSERT INTO addresses (
    id,
    userId,
    label,
    recipient,
    street,
    number,
    complement,
    district,
    city,
    state,
    zipCode,
    isDefault,
    createdAt,
    updatedAt
)
SELECT
    UUID(),
    user_id,
    'Endereco principal',
    nome,
    rua,
    CAST(n AS CHAR),
    NULL,
    bairro,
    cidade,
    estado,
    cep,
    TRUE,
    NOW(3),
    NOW(3)
FROM seed_usuarios;

-- Confirma as alteracoes.
COMMIT;

-- Limpa a tabela temporaria.
DROP TEMPORARY TABLE seed_usuarios;

-- =====================================================
-- VALIDACAO
-- =====================================================

SELECT COUNT(*) AS total_usuarios_teste
FROM users
WHERE email LIKE 'usuario.teste.%@exemplo.com';

SELECT COUNT(*) AS total_enderecos_teste
FROM addresses
WHERE recipient LIKE 'Usuario Teste %';

-- Conferir alguns cadastros e seus enderecos.
SELECT
    u.name,
    u.email,
    a.street,
    a.number,
    a.district,
    a.city,
    a.state,
    a.zipCode
FROM users u
INNER JOIN addresses a ON a.userId = u.id
WHERE u.email LIKE 'usuario.teste.%@exemplo.com'
ORDER BY u.email
LIMIT 10;

